{
    "name": "maksimovic/laminas-auradi-config",
    "description": "PSR-11 Aura.DI container configurator for Laminas and Mezzio applications. Drop-in replacement for the archived laminas/laminas-auradi-config with PHP 8.4 and 8.5 support.",
    "license": "BSD-3-Clause",
    "keywords": [
        "laminas",
        "mezzio",
        "aura di",
        "container",
        "psr-11"
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.1.99"
        }
    },
    "replace": {
        "laminas/laminas-auradi-config": "self.version"
    },
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "aura/di": "^4.2"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "~2.5.0",
        "laminas/laminas-container-config-test": "^1.0.0",
        "phpunit/phpunit": "^10.5",
        "psalm/plugin-phpunit": "^0.18.3",
        "vimeo/psalm": "^5.17"
    },
    "conflict": {
        "container-interop/container-interop": "<1.2.0"
    },
    "autoload": {
        "psr-4": {
            "Laminas\\AuraDi\\Config\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaminasTest\\AuraDi\\Config\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "static-analysis": "psalm --shepherd --stats",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    }
}
